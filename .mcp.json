{
  "mcpServers": {
    "bento": {
      "command": "npx",
      "args": ["-y", "@bentonow/bento-mcp"],
      "env": {
        "BENTO_PUBLISHABLE_KEY": "${BENTO_PUBLISHABLE_KEY:-injected-by-network-proxy}",
        "BENTO_SECRET_KEY": "${BENTO_SECRET_KEY:-injected-by-network-proxy}",
        "BENTO_SITE_UUID": "${BENTO_SITE_UUID}"
      }
    }
  }
}
